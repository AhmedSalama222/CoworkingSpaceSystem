@model CoworkingSpaceSystem.BLL.DTOs.SpaceDTOs.SpaceToReturnDto

@{
    ViewData["Title"] = "حذف القاعة";
}

<div class="container mt-4">
    <div class="alert alert-danger shadow">
        <h3>⚠️ هل أنت متأكد من رغبتك في حذف هذه القاعة نهائياً؟</h3>
        <p class="mb-0">هذا الإجراء لا يمكن التراجع عنه بعد إتمامه.</p>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <h4>@Model.Name</h4>
            <p><strong>الوصف:</strong> @Model.Description</p>
            <p><strong>سعر الساعة:</strong> @Model.PricePerHour ج.م</p>
            <p><strong>السعة:</strong> @Model.Capacity فرد</p>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger btn-lg"><i class="bi bi-trash"></i> نعم، تأكيد الحذف</button>
        <a asp-action="Index" class="btn btn-secondary btn-lg">إلغاء</a>
    </form>
</div>